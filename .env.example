# 项目目录
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output

# MinerU Parser 配置
PARSER=mineru
PARSE_METHOD=auto

# 多模态处理开关
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true

# 上下文配置
CONTEXT_WINDOW=1
CONTEXT_MODE=page
MAX_CONTEXT_TOKENS=2000
INCLUDE_HEADERS=true
INCLUDE_CAPTIONS=true
USE_FULL_PATH=false

# LightRAG 查询配置
TOP_K=16
CHUNK_TOP_K=8

# 模型服务
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
VISION_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

